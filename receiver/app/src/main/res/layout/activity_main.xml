<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Header: logo + theme switch -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="4dp">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_nullwire_logo" android:contentDescription="NullWire logo"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="NullWire" android:textColor="@color/color_text" android:textSize="20sp" android:textStyle="bold"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/seg_track" android:gravity="center_vertical" android:orientation="horizontal" android:padding="3dp">
                <TextView android:id="@+id/btnThemeLight" android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center" android:text="☀" android:textSize="16sp" android:textColor="@color/color_text" android:contentDescription="Light theme" android:clickable="true" android:focusable="true"/>
                <TextView android:id="@+id/btnThemeDark" android:layout_width="44dp" android:layout_height="match_parent" android:gravity="center" android:text="☾" android:textSize="16sp" android:textColor="@color/color_text" android:contentDescription="Dark theme" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
        </LinearLayout>

        <ScrollView android:id="@+id/rootScrollView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
<LinearLayout android:id="@+id/pageStream" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="12dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
<View android:id="@+id/viewStatusDot" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/dot_active"/>
<TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Ready to receive audio" android:textColor="@color/color_text_sec" android:textSize="14sp" android:textStyle="bold"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
<ImageView android:layout_width="56dp" android:layout_height="56dp" android:padding="12dp" android:background="@drawable/tile_bg" android:src="@drawable/ic_pc" android:importantForAccessibility="no"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="This PC" android:textColor="@color/color_text" android:textSize="13sp"/>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="····" android:textColor="@color/color_green" android:textSize="20sp" android:textStyle="bold"/>
<ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:src="@drawable/ic_wifi" android:importantForAccessibility="no"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="····" android:textColor="@color/color_green" android:textSize="20sp" android:textStyle="bold"/>
</LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
<ImageView android:layout_width="56dp" android:layout_height="56dp" android:padding="12dp" android:background="@drawable/tile_bg" android:src="@drawable/ic_phone" android:importantForAccessibility="no"/>
<TextView android:id="@+id/tvDeviceName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="This phone" android:textColor="@color/color_text" android:textSize="13sp"/>
</LinearLayout>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="48 kHz · Stereo PCM" android:textColor="@color/color_text_sec" android:textSize="11sp"/>
<com.nullwire.receiver.SpectrumView android:id="@+id/spectrumView" android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="14dp" android:contentDescription="Live audio level"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/tvLatency" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- ms" android:textColor="@color/color_text" android:textSize="26sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Buffered latency" android:textColor="@color/color_text_sec" android:textSize="12sp"/>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="28dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/chip_bg" android:text="48 kHz" android:textColor="@color/color_green" android:textSize="12sp" android:textStyle="bold"/>
<TextView android:layout_width="wrap_content" android:layout_height="28dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/chip_bg" android:text="Lossless" android:textColor="@color/color_green" android:textSize="12sp" android:textStyle="bold"/>
</LinearLayout>
<TextView android:id="@+id/tvStats" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Packets: 0" android:textColor="@color/color_text_sec" android:textSize="11sp" android:fontFamily="monospace"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<TextView android:id="@+id/btnPresetPure" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="0dp" android:gravity="center" android:text="Pure" android:textSize="12sp" android:textColor="@color/color_text" android:background="@drawable/tile_bg" android:clickable="true" android:focusable="true"/><TextView android:id="@+id/btnPresetStudio" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:text="Studio" android:textSize="12sp" android:textColor="@color/color_text" android:background="@drawable/tile_bg" android:clickable="true" android:focusable="true"/><TextView android:id="@+id/btnPresetCinema" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:text="Cinema" android:textSize="12sp" android:textColor="@color/color_text" android:background="@drawable/tile_bg" android:clickable="true" android:focusable="true"/><TextView android:id="@+id/btnPresetGame" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center" android:text="Game" android:textSize="12sp" android:textColor="@color/color_text" android:background="@drawable/tile_bg" android:clickable="true" android:focusable="true"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Master volume" android:textColor="@color/color_text" android:textSize="13sp"/>
<TextView android:id="@+id/tvVolumeVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="80%" android:textColor="@color/color_text_sec" android:textSize="13sp"/>
</LinearLayout>
<SeekBar android:id="@+id/sbVolume" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
</LinearLayout>
<Button android:id="@+id/btnListen" android:layout_width="match_parent" android:layout_height="54dp" android:text="▶ Listen (Connect Audio)" android:textStyle="bold" android:textSize="15sp" android:textAllCaps="false" android:layout_marginTop="16dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/pageSound" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="12dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SOUND SHAPING" android:textColor="@color/color_text_sec" android:textSize="11sp" android:letterSpacing="0.08" android:textStyle="bold" /><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bass · low shelf 80 Hz" android:textColor="@color/color_text" android:textSize="13sp"/>
<TextView android:id="@+id/tvBassVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+0 dB" android:textColor="@color/color_green" android:fontFamily="monospace" android:textStyle="bold"/>
</LinearLayout>
<SeekBar android:id="@+id/sbBass" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="12" android:progress="0" android:layout_marginTop="6dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Air · high shelf 12 kHz" android:textColor="@color/color_text" android:textSize="13sp"/>
<TextView android:id="@+id/tvTrebleVal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+0 dB" android:textColor="@color/color_green" android:fontFamily="monospace" android:textStyle="bold"/>
</LinearLayout>
<SeekBar android:id="@+id/sbTreble" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="10" android:progress="0" android:layout_marginTop="6dp"/>
</LinearLayout>
</LinearLayout>
<LinearLayout android:id="@+id/pageDevices" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="12dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PHONE WI-FI IP ADDRESS" android:textColor="@color/color_text_sec" android:textSize="11sp" android:letterSpacing="0.08" android:textStyle="bold" />
<TextView android:id="@+id/tvIpAddress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="192.168.1.x" android:textColor="@color/color_green" android:textSize="26sp" android:textStyle="bold" android:fontFamily="monospace" android:layout_marginTop="6dp"/>
<TextView android:id="@+id/tvPairingPin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pairing PIN: ------" android:textColor="@color/color_text" android:textSize="15sp" android:textStyle="bold" android:fontFamily="monospace" android:layout_marginTop="10dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Auto-discovered by the Windows app on the same Wi-Fi network." android:textColor="@color/color_text_sec" android:textSize="12sp" android:layout_marginTop="6dp"/>
</LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="16dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PHONE MICROPHONE" android:textColor="@color/color_text_sec" android:textSize="11sp" android:letterSpacing="0.08" android:textStyle="bold" />
<TextView android:id="@+id/tvMicStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mic: Idle (Stream phone voice to PC)" android:textColor="@color/color_text" android:textSize="13sp" android:layout_marginTop="6dp"/>
<Button android:id="@+id/btnMic" android:layout_width="match_parent" android:layout_height="48dp" android:text="🎙 Start Phone Mic (to PC)" android:textStyle="bold" android:textAllCaps="false" android:layout_marginTop="12dp"/>
</LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WI-FI FASTPATH" android:textColor="@color/color_text_sec" android:textSize="11sp" android:letterSpacing="0.08" android:textStyle="bold" />
<TextView android:id="@+id/tvWifiAccelStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡ Acceleration Active (Low-Latency Lock &amp; Nice -19)" android:textColor="@color/color_green" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="2dp"/>
</LinearLayout>
<androidx.appcompat.widget.SwitchCompat android:id="@+id/switchWifiAccel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true"/>
</LinearLayout>
</LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AUTO RESET CONNECTION" android:textColor="@color/color_text_sec" android:textSize="11sp" android:letterSpacing="0.08" android:textStyle="bold" />
<TextView android:id="@+id/tvAutoResetStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Resets on delay and every 10 min" android:textColor="@color/color_green" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="2dp"/>
</LinearLayout>
<androidx.appcompat.widget.SwitchCompat android:id="@+id/switchAutoReset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true"/>
</LinearLayout>
<Button android:id="@+id/btnResetInterval" android:layout_width="match_parent" android:layout_height="46dp" android:text="⚙ Reset interval: 10 min" android:textAllCaps="false" android:layout_marginTop="12dp"/>
</LinearLayout>
</LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Bottom navigation -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/nav_bar_bg" android:orientation="horizontal" android:padding="6dp" android:layout_marginBottom="4dp">
<LinearLayout android:id="@+id/navStream" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/nav_item_bg" android:clickable="true" android:focusable="true">
<ImageView android:id="@+id/navStreamIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_stream" android:importantForAccessibility="no"/>
<TextView android:id="@+id/navStreamLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stream" android:textSize="11sp" android:textColor="@color/color_text_sec" android:layout_marginTop="2dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/navSound" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/nav_item_bg" android:clickable="true" android:focusable="true">
<ImageView android:id="@+id/navSoundIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_sound" android:importantForAccessibility="no"/>
<TextView android:id="@+id/navSoundLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sound" android:textSize="11sp" android:textColor="@color/color_text_sec" android:layout_marginTop="2dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/navDevices" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/nav_item_bg" android:clickable="true" android:focusable="true">
<ImageView android:id="@+id/navDevicesIcon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_devices" android:importantForAccessibility="no"/>
<TextView android:id="@+id/navDevicesLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Devices" android:textSize="11sp" android:textColor="@color/color_text_sec" android:layout_marginTop="2dp"/>
</LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Floating toast HUD -->
    <LinearLayout
        android:id="@+id/layoutToastBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="110dp"
        android:background="@drawable/toast_bg"
        android:elevation="14dp"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:visibility="gone">
        <View android:id="@+id/viewToastDot" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/dot_active"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/tvToastTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONNECTED TO PC" android:textColor="@color/color_text" android:textSize="13sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvToastMessage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Streaming Lossless 48kHz PCM Audio" android:textColor="@color/color_text_sec" android:textSize="11sp" android:layout_marginTop="2dp"/>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
