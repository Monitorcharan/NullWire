<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg">

    <ScrollView
        android:id="@+id/rootScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/rootLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- Modern Header with Official Logo & Badges -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_nullwire_logo"
                    android:contentDescription="NullWire Logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NullWire Pro"
                        android:textColor="@color/color_text"
                        android:textSize="24sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hardware Direct MMAP · Lossless 48kHz"
                        android:textColor="@color/color_green"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- IP & Pairing Identity Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PHONE WI-FI IP ADDRESS"
                    android:textColor="@color/color_text_sec"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvIpAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="192.168.1.x"
                    android:textColor="@color/color_accent"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvPairingPin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pairing PIN: ------"
                    android:textColor="@color/color_green"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto-discovered by Windows app automatically on the same Wi-Fi network."
                    android:textColor="@color/color_text_sec"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Real-Time Audio Telemetry & Spectrum Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ready to receive audio"
                        android:textColor="@color/color_text_sec"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&lt;2.67ms"
                        android:textColor="@color/color_accent"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbLevelMeter"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="14dp"
                    android:progress="0"
                    android:max="100"
                    android:progressTint="@color/color_green"
                    android:progressBackgroundTint="@color/color_border" />

                <TextView
                    android:id="@+id/tvStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Packets: 0  ·  DMA Idle  ·  0.0% Loss"
                    android:textColor="@color/color_text_sec"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- Acoustic Hardware DSP Equalizer Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HARDWARE ACOUSTIC TUNING"
                    android:textColor="@color/color_text_sec"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <!-- Bass Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Natural Sub-Bass (80Hz):"
                        android:textColor="@color/color_text"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvBassVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+0 dB"
                        android:textColor="@color/color_green"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/sbBass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="12"
                    android:progress="0"
                    android:layout_marginTop="6dp" />

                <!-- Treble Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Studio Air &amp; Clarity (12kHz):"
                        android:textColor="@color/color_text"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvTrebleVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+0 dB"
                        android:textColor="@color/color_accent"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/sbTreble"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="10"
                    android:progress="0"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Wireless Mic Stream Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WIRELESS PHONE / HEADSET MICROPHONE"
                    android:textColor="@color/color_text_sec"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMicStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mic: Idle (Stream phone voice to PC)"
                    android:textColor="@color/color_text"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnMic"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🎙 Start Phone Mic (to PC)"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="@color/color_card"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Real-Time Wi-Fi Acceleration Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WI-FI REAL-TIME ACCELERATION"
                            android:textColor="@color/color_text_sec"
                            android:textSize="11sp"
                            android:letterSpacing="0.08"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvWifiAccelStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ Acceleration Active (Low-Latency Lock &amp; Nice -19)"
                            android:textColor="@color/color_green"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchWifiAccel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Primary Connection Button -->
            <Button
                android:id="@+id/btnListen"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="▶ Listen (Connect Audio)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="@color/color_accent"
                android:textSize="15sp"
                android:layout_marginTop="20dp" />

        </LinearLayout>
    </ScrollView>

    <!-- In-App Floating Toast HUD Card (3-5 Seconds Auto-Dismiss) -->
    <LinearLayout
        android:id="@+id/layoutToastBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/toast_bg"
        android:elevation="14dp"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <View
            android:id="@+id/viewToastDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_active" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvToastTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ CONNECTED TO PC"
                android:textColor="@color/color_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvToastMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Streaming Lossless 48kHz PCM Audio"
                android:textColor="@color/color_text_sec"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
